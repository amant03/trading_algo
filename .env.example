# Copy to .env and fill in (never commit .env). cloud-init.sh generates
# these automatically on a fresh VM.
PGDATABASE=trading_platform
PGUSER=trading_app
# openssl rand -hex 24
PGPASSWORD=change-me-in-production
# openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Free wildcard-DNS hostname for this VM, e.g. 203-0-113-10.nip.io
DOMAIN=tradealgo.example.invalid
